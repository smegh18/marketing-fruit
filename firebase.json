{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|json|wasm|woff2|png|jpg|jpeg|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src * data: blob: 'unsafe-inline' 'unsafe-eval'"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },

  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "marketingfruit-9e24d",
          "appId": "1:865810323989:android:47f5f4d52d624520c0cc1c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "marketingfruit-9e24d",
          "configurations": {
            "android": "1:865810323989:android:47f5f4d52d624520c0cc1c",
            "ios": "1:865810323989:ios:4e25850d36c5af80c0cc1c",
            "web": "1:865810323989:web:3ea07157f62d0c0bc0cc1c"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  }
}
